# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# postgres://user:password@host:5432/database
DATABASE_URL=postgres://clover:clover@localhost:5432/clover_clinic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Login lockout policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Used once by the initial-Management-user seed. Change the password immediately after first login.
SEED_MANAGEMENT_EMAIL=management@cloverfamilycareabc.com
SEED_MANAGEMENT_PASSWORD=change-me-immediately
SEED_MANAGEMENT_FULL_NAME=Clinic Management
